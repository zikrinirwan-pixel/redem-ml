<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Peringatan Sistem!</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: #0a0a0a;
      color: #00ff00;
      font-family: 'Courier New', Courier, monospace;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 100vh;
      overflow: hidden;
      padding: 20px;
      text-align: center;
    }

    /* Tampilan Awal Peringatan */
    #warning-box {
      border: 2px solid #ff0000;
      background-color: #1a0000;
      padding: 25px;
      border-radius: 12px;
      max-width: 380px;
      width: 100%;
      box-shadow: 0 0 25px rgba(255, 0, 0, 0.6);
      animation: shake 0.4s infinite;
    }

    @keyframes shake {
      0% { transform: translate(1px, 1px) rotate(0deg); }
      25% { transform: translate(-2px, -1px) rotate(-1deg); }
      50% { transform: translate(-1px, 2px) rotate(1deg); }
      75% { transform: translate(2px, 1px) rotate(0deg); }
      100% { transform: translate(1px, -2px) rotate(-1deg); }
    }

    h1 { color: #ff3333; font-size: 24px; margin-bottom: 10px; }
    p { color: #ffffff; font-size: 14px; margin-bottom: 15px; line-height: 1.5; }

    .progress-container {
      width: 100%;
      background-color: #333;
      border-radius: 8px;
      overflow: hidden;
      margin: 15px 0;
      height: 22px;
      border: 1px solid #ff3333;
    }

    .progress-bar {
      height: 100%;
      width: 0%;
      background-color: #ff0000;
      transition: width 0.2s;
    }

    #log-text {
      color: #00ff00;
      font-size: 12px;
      min-height: 20px;
      margin-bottom: 15px;
    }

    button {
      background-color: #ff0000;
      color: white;
      border: none;
      padding: 12px 24px;
      font-size: 16px;
      font-weight: bold;
      border-radius: 8px;
      cursor: pointer;
      width: 100%;
      text-transform: uppercase;
    }

    /* Tampilan Akhir Prank */
    #prank-result {
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      animation: popIn 0.3s ease-out;
    }

    @keyframes popIn {
      0% { transform: scale(0.3); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    .big-text {
      font-family: Arial, sans-serif;
      font-size: 46px;
      font-weight: 900;
      color: #ffcc00;
      text-shadow: 0 0 15px #ff0000;
      margin-bottom: 10px;
      text-transform: uppercase;
    }

    .emoji {
      font-size: 90px;
      margin: 15px 0;
    }

    .sub-prank {
      color: #aaa;
      font-family: sans-serif;
      font-size: 14px;
      margin-top: 20px;
    }
  </style>
</head>
<body>

  <!-- Layar Simulasi Virus -->
  <div id="warning-box">
    <h1>⚠️ BAHAYA: VIRUS TERDETEKSI!</h1>
    <p>Sistem keamanan HP Anda telah ditembus. Menghapus seluruh foto, kontak, dan data WhatsApp...</p>
    
    <div class="progress-container">
      <div class="progress-bar" id="bar"></div>
    </div>
    
    <div id="log-text">Menginisialisasi penghapusan... 0%</div>
    
    <button onclick="triggerPrank()">HENTIKAN SEKARANG!</button>
  </div>

  <!-- Layar Kejutan Prank -->
  <div id="prank-result">
    <div class="emoji">🖕</div>
    <div class="big-text">ANK BASONG</div>
    <p style="font-family: sans-serif; font-size: 18px; color: white;">Panik gak? Panik gak? Panik lah masa enggak! 😂</p>
    <div class="sub-prank">(Tenang, ini cuma prank web aman kok!)</div>
  </div>

  <script>
    let progress = 0;
    const bar = document.getElementById('bar');
    const logText = document.getElementById('log-text');
    const logs = [
      "Mengakses galeri foto...",
      "Menyalin riwayat chat WhatsApp...",
      "Menghapus kontak telepon...",
      "Mengunggah data ke server...",
      "Mengunci layar perangkat...",
      "Merusak sistem Android..."
    ];

    // Jalankan loading bar otomatis
    const interval = setInterval(() => {
      progress += Math.floor(Math.random() * 8) + 3;
      if (progress >= 100) {
        progress = 100;
        clearInterval(interval);
        triggerPrank();
      }
      bar.style.width = progress + '%';
      const randomLog = logs[Math.floor(Math.random() * logs.length)];
      logText.innerText = `${randomLog} (${progress}%)`;
    }, 350);

    // Fungsi saat tombol ditekan atau loading mencapai 100%
    function triggerPrank() {
      clearInterval(interval);
      // Efek getar di HP (jika browser mendukung)
      if (navigator.vibrate) {
        navigator.vibrate([300, 100, 300, 100, 500]);
      }
      document.getElementById('warning-box').style.display = 'none';
      document.getElementById('prank-result').style.display = 'flex';
      document.body.style.backgroundColor = '#111';
    }
  </script>

</body>
</html>
